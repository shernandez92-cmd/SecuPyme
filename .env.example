# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development          # development | production | test
LOG_LEVEL=debug               # error | warn | info | debug

# ── Base de datos ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/secupyme

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_string_largo_y_aleatorio

# ── Email (Gmail) ─────────────────────────────────────────────────────────────
EMAIL_USER=tu_cuenta@gmail.com
EMAIL_PASS=app_password_de_gmail   # contraseña de aplicación, no la normal

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://secupyme.onrender.com
CLIENT_URL=https://secupyme.onrender.com

# ── Cloudinary (almacenamiento de archivos) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── APIs externas ─────────────────────────────────────────────────────────────
GROQ_API_KEY=                 # https://console.groq.com
SHODAN_KEY=                   # https://account.shodan.io
VIRUSTOTAL_KEY=               # https://www.virustotal.com/gui/my-apikey

# ── Cron jobs ─────────────────────────────────────────────────────────────────
CRON_SECRET=string_secreto_para_el_endpoint_de_monitoreo
